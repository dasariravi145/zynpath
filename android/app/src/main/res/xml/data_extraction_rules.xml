<?xml version="1.0" encoding="utf-8"?>
<!-- Data Extraction Rules for Android 12+ (API 31+) per Google Play Security Best Practices -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve local Solo puzzle level progression, stars, and preferences -->
        <include domain="database" path="zynpath_database" />
        <include domain="sharedpref" path="." />
        <!-- Strictly exclude hardware Keystore encrypted session files to prevent cross-device decryption failure -->
        <exclude domain="file" path="zyn_secure_session.enc" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="zynpath_database" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="zyn_secure_session.enc" />
    </device-transfer>
</data-extraction-rules>
