# ==============================================================================
# ZYNPATH RELEASE KEYSTORE CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL PASSWORDS OR KEYSTORE FILES TO VERSION CONTROL.
# Copy this file to "keystore.properties" and fill in your actual values.
# ==============================================================================

# Path to your release upload keystore (absolute or relative to android/app directory)
storeFile=/path/to/zynpath-upload-keystore.jks

# Password for the keystore
storePassword=CHANGE_ME_KEYSTORE_PASSWORD

# Alias name for the upload key
keyAlias=zynpath-upload-key

# Password for the key alias
keyPassword=CHANGE_ME_KEY_PASSWORD
